
# ── Secrets ───────────────────────────────────────────────────────────────────
.env
.env.*

# ── Migration / cutover artifacts (contain DSNs and operational metadata) ────
# These are produced by scripts/ during database migration / cutover work.
# They are intentionally kept locally for rollback evidence and audit, but
# MUST NEVER be committed because they include DATABASE_URL with passwords.
_*.json
_*.txt
_*.log
_*.err
nahla-backups/
*.dump

# ── Standalone audit/trace outputs ────────────────────────────────────────────
audit_*.txt
pg_logs_*.txt
trace_*.txt
.nahla-acceptance-sessions/

# ── Python compiled / cache ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
env/

# ── Debug / scratch files ─────────────────────────────────────────────────────
backend/request.json

# ── Frontend build output (regenerated by `npm run build`) ───────────────────
dashboard/dist/

# ── Node ──────────────────────────────────────────────────────────────────────
node_modules/

# ── Coverage / test artifacts ─────────────────────────────────────────────────
.coverage
htmlcov/
.pytest_cache/

# ── Editor / OS ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
