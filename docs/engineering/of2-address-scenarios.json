    {
      "scenario_id": "continuation_after_captured_choice",
      "_note": [
        "Two turns: the first is offered saved addresses, the second replays",
        "an action id taken from the first turn's CAPTURED payload. The",
        "runner forwards scenario inbound_metadata, and the placeholder",
        "below is substituted with the captured id of the offered address",
        "at the index named by captured_action_index."
      ],
      "turns": [
        {
          "text": "ابغى اكمل الطلب",
          "mode": "of2",
          "expected_status": "evaluated",
          "failure_injection": "none",
          "expects_address_turn": true,
          "expectations": {
            "collection_field": "delivery_address",
            "response_goal": "collect_delivery_address",
            "missing_field": "delivery_address",
            "expected_execution_path": "ordinary"
          },
          "expected_denials": [],
          "expected_operational_result": "address_reply"
        },
        {
          "text": "اختيار العنوان",
          "mode": "of2",
          "expected_status": "evaluated",
          "failure_injection": "none",
          "expects_address_turn": false,
          "captured_action_index": 0,
          "inbound_metadata": {
            "button_id": "__captured_action_id__"
          },
          "expected_denials": [],
          "expected_operational_result": "structured_selection",
          "expected_state_delta_keys": [
            "conversation_metadata_fingerprint"
          ]
        }
      ]
    }
