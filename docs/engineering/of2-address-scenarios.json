{
  "scenario_schema_version": "internal_conversational_e2e_scenarios_v2",
  "_readme": [
    "Executable manifest for the OrderFlowV2 address validation harness.",
    "Every OF2 turn must state expects_address_turn and, when true, the",
    "field and goal it expects; an unstated expectation cannot be",
    "contradicted by any evidence. failure_injection is one of none,",
    "provider_error, provider_timeout, guard_boundary and installs a real",
    "fault at the named seam. No turn asserts reply wording."
  ],
  "scenarios": [
    {
      "scenario_id": "ordinary_delivery_address_one_saved",
      "turns": [
        {
          "text": "ابغى اكمل الطلب",
          "mode": "of2",
          "expected_status": "evaluated",
          "failure_injection": "none",
          "expects_address_turn": true,
          "expectations": {
            "collection_field": "delivery_address",
            "response_goal": "collect_delivery_address",
            "missing_field": "delivery_address",
            "expected_execution_path": "ordinary"
          },
          "expected_denials": [],
          "expected_operational_result": "address_reply"
        }
      ]
    },
    {
      "scenario_id": "ordinary_no_saved_choices",
      "turns": [
        {
          "text": "ابغى اكمل الطلب",
          "mode": "of2",
          "expected_status": "evaluated",
          "failure_injection": "none",
          "expects_address_turn": true,
          "expectations": {
            "collection_field": "delivery_address",
            "response_goal": "collect_delivery_address",
            "missing_field": "delivery_address",
            "expected_execution_path": "ordinary",
            "expected_surface": "text"
          },
          "expected_denials": [],
          "expected_operational_result": "address_reply"
        }
      ]
    },
    {
