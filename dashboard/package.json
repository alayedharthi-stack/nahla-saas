{
  "name": "nahla-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "check:i18n": "npx --yes tsx@4 scripts/check-embedded-i18n.mts",
    "check:i18n-static": "npx --yes tsx@4 scripts/check-i18n-static.mts",
    "check:resolvers": "npx --yes tsx@4 scripts/smoke-embedded-resolvers.mts",
    "check:billing-redirects": "npx --yes tsx@4 scripts/check-billing-redirects.mts",
    "check:navigation-policy": "npx --yes tsx@4 scripts/check-navigation-policy.mts",
    "check:nav-simplified-p31": "npx --yes tsx@4 scripts/check-nav-simplified-p31.mts",
    "check:nav-marketing-p32": "npx --yes tsx@4 scripts/check-nav-marketing-p32.mts",
    "check:platform-telemetry": "npx --yes tsx@4 scripts/check-platform-telemetry.mts",
    "check:platform-feature-flags": "npx --yes tsx@4 scripts/check-platform-feature-flags.mts",
    "check:page-metadata": "npx --yes tsx@4 scripts/check-page-metadata.mts",
    "check:route-hierarchy": "npx --yes tsx@4 scripts/check-route-hierarchy.mts",
    "check:product-identity": "npx --yes tsx@4 scripts/check-product-identity.mts",
    "check:ai-toggle-projection": "npx --yes tsx@4 scripts/check-ai-toggle-projection.mts",
    "check:platform-policy": "npm run check:navigation-policy && npm run check:nav-simplified-p31 && npm run check:nav-marketing-p32 && npm run check:page-metadata && npm run check:route-hierarchy && npm run check:product-identity && npm run check:platform-telemetry && npm run check:platform-feature-flags && npm run check:ai-toggle-projection",
    "check:plan-features": "npx --yes tsx@4 scripts/check-plan-features.mts",
    "check:no-native-dialogs": "npx --yes tsx@4 scripts/check-no-native-dialogs.mts",
    "check:meta-embedded-signup-login": "npx --yes tsx@4 scripts/check-meta-embedded-signup-login.mts",
    "check:simplified-whatsapp-connect": "npx --yes tsx@4 scripts/check-simplified-whatsapp-connect.mts",
    "check:orders-tab-load": "npx --yes tsx@4 scripts/check-orders-tab-load.mts",
    "smoke:order-catalog-pick": "npx --yes tsx@4 scripts/smoke-order-catalog-pick.mts",
    "check:embedded-navigation": "npx --yes tsx@4 scripts/smoke-embedded-navigation.mts",
    "check:embedded-reconcile-telemetry": "npx --yes tsx@4 scripts/smoke-embedded-reconcile-telemetry.mts",
    "check:embedded-reconcile-cta-apibase": "npx --yes tsx@4 scripts/smoke-embedded-reconcile-cta-apibase.mts"
  },
  "dependencies": {
    "@sentry/react": "^8.30.0",
    "lucide-react": "^0.321.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.0",
    "recharts": "^2.10.3"
  },
  "devDependencies": {
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "playwright": "^1.60.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.0"
  }
}
