# ─────────────────────────────────────────────────────────────────────────────
# Nahla SaaS — Environment Variables Reference
# Copy this file to .env and fill in the values.
# NEVER commit a .env file containing real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core / Security ──────────────────────────────────────────────────────────
# Phase 1A note: production REFUSES to boot when these match a known
# placeholder. Generate fresh random values:
#   JWT_SECRET     : openssl rand -hex 32
#   ADMIN_PASSWORD : openssl rand -base64 24   (≥ 12 chars, no spaces)
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@nahlah.ai
ADMIN_PASSWORD=change-me
JWT_EXPIRE_HOURS=24              # Phase 1A default; was 168 (7d)
ENVIRONMENT=development          # development | staging | production
BACKEND_URL=https://api.nahlah.ai
DASHBOARD_URL=https://app.nahlah.ai

# ── Database ─────────────────────────────────────────────────────────────────
# Production: append ?sslmode=require to enforce TLS to Postgres.
DATABASE_URL=postgresql://user:password@localhost:5432/nahla

# ── Redis (shared rate limit + JWT revocation list, Phase 1A) ────────────────
# Optional in dev (in-process fallback engages when empty).
# REQUIRED in production for cross-worker correctness.
REDIS_URL=

# ── Sentry (Phase 1A) ────────────────────────────────────────────────────────
# Backend DSN (server). Empty = error monitoring disabled.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
# Dashboard DSN — set in the dashboard Railway service. Baked into the
# Vite build, so a redeploy is required after change. Use a SEPARATE
# Sentry project from the backend.
VITE_SENTRY_DSN=
VITE_SENTRY_ENV=production
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Registration ─────────────────────────────────────────────────────────────
REQUIRE_INVITE=true              # false to allow open registration

# ── WhatsApp / Meta ───────────────────────────────────────────────────────────
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=
# Phase 1A: production refuses to boot when this matches `nahla2025` or
# any known placeholder. Generate ≥ 16 chars random and update the
# Meta Business webhook config to match.
WHATSAPP_VERIFY_TOKEN=
WA_BUSINESS_ACCOUNT_ID=
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v20.0
META_WA_CONFIG_ID=               # optional — Meta Embedded Signup config
# Phase 1B — Meta inbound webhook (X-Hub-Signature-256) enforcement.
# Default audit-only. Promote to true after a 7-day clean window in
# /admin/webhooks/audit-summary?provider=meta.
META_WEBHOOK_ENFORCE_SIGNATURE=false
META_WEBHOOK_ALLOW_MISSING_SIGNATURE=true

# ── 360dialog (WhatsApp Coexistence) ─────────────────────────────────────────
D360_API_BASE_URL=https://waba-v2.360dialog.io
D360_PARTNER_HUB_BASE=https://hub.360dialog.com
D360_PARTNER_API_KEY=
D360_PARTNER_ID=
D360_WEBHOOK_INTERNAL_SECRET=
D360_COHOST_ENABLED=false

# ── Salla OAuth ───────────────────────────────────────────────────────────────
SALLA_CLIENT_ID=
SALLA_CLIENT_SECRET=
SALLA_REDIRECT_URI=https://api.nahlah.ai/oauth/salla/callback
SALLA_WEBHOOK_SECRET=
SALLA_EMBEDDED_URL=https://app.nahlah.ai
# Phase 1B — webhook signature enforcement (Salla).
# Default is audit-only: signatures are verified and logged to
# /admin/webhooks/audit-summary but never rejected. Per-tenant overrides
# in TenantSettings.extra_metadata.webhook_enforcement.salla.enforce
# take precedence over this global flag — see
# docs/security/WEBHOOK_SECURITY.md for the rollout sequence.
SALLA_WEBHOOK_ENFORCE_SIGNATURE=false
SALLA_WEBHOOK_ALLOW_MISSING_SIGNATURE=true
# Test app (separate credentials, does not affect production)
SALLA_TEST_CLIENT_ID=
SALLA_TEST_CLIENT_SECRET=
SALLA_TEST_REDIRECT_URI=https://api.nahlah.ai/oauth/salla/test/callback

# ── Salla OAuth (Sync) App — Dual Integration Architecture ───────────────────
# تطبيق سلة الثاني المخصص لجلب refresh_token عبر OAuth flow.
# مستقل تمامًا عن SALLA_CLIENT_* أعلاه — يجب إنشاء تطبيق منفصل في
# Partner Portal من نوع General/Custom OAuth ويُسجَّل redirect_uri الجديد.
# هذه القيم تُستخدم فقط في:
#   • GET  /api/salla/oauth/start       (client_id + redirect_uri)
#   • GET  /api/salla/oauth/callback    (client_id + client_secret + redirect_uri)
#   • POST /webhook/salla-oauth         (webhook secret)
# لا تتداخل مع التطبيق الأساسي / Embedded / Communication.
SALLA_OAUTH_CLIENT_ID=
SALLA_OAUTH_CLIENT_SECRET=
SALLA_OAUTH_REDIRECT_URI=https://api.nahlah.ai/api/salla/oauth/callback
SALLA_OAUTH_WEBHOOK_SECRET=

# ── Zid OAuth ─────────────────────────────────────────────────────────────────
ZID_CLIENT_ID=
ZID_CLIENT_SECRET=
ZID_REDIRECT_URI=https://api.nahlah.ai/zid/redirect
ZID_WEBHOOK_SECRET=
# Phase 1B — Zid signature enforcement. Default audit-only.
# When ZID_WEBHOOK_REQUIRED_AT_BOOT=true the preflight check refuses to
# start the worker if ZID_WEBHOOK_SECRET is empty in production.
ZID_WEBHOOK_ENFORCE_SIGNATURE=false
ZID_WEBHOOK_REQUIRED_AT_BOOT=false

# ── AI / Claude (Anthropic) ───────────────────────────────────────────────────
# CLAUDE_API_KEY is checked first; ANTHROPIC_API_KEY is the fallback.
CLAUDE_API_KEY=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5
ANTHROPIC_SLOT_MODEL=claude-3-5-haiku-20241022  # model used by slot extractor

# ── AI / OpenAI-compatible ────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_AUDIO_MODEL=whisper-1

# ── SPL National Address API ──────────────────────────────────────────────────
# Resolves Saudi national short address codes (e.g. RIYD1234) and GPS
# coordinates (from Google Maps / Apple Maps / Waze links) into structured
# address fields (city, district, street, postal_code) for order checkout.
#
# Without this key:
#   - Short codes and map links are still accepted and forwarded in order notes.
#   - Auto-fill of city/district/street/postal_code is disabled.
#
# Get a free key at: https://address.gov.sa/en/developer
SPL_NATIONAL_ADDRESS_API_KEY=
SPL_NATIONAL_ADDRESS_BASE_URL=https://apina.address.gov.sa/NationalAddress/v3.1

# ── Email ─────────────────────────────────────────────────────────────────────
# Option A — Resend (recommended)
RESEND_API_KEY=
EMAIL_FROM=نحلة <support@nahlah.ai>
# Option B — SMTP (Zoho or any SMTP relay)
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_USE_TLS=true

# ── Payment Gateways ──────────────────────────────────────────────────────────
MOYASAR_SECRET_KEY=
MOYASAR_PUBLISHABLE_KEY=
MOYASAR_WEBHOOK_SECRET=
HYPERPAY_ACCESS_TOKEN=
HYPERPAY_ENTITY_ID=
HYPERPAY_WEBHOOK_SECRET=
HYPERPAY_LIVE_MODE=false
# Phase 1B — payment webhook strict-verification flags.
# Default audit-only. Promote after audit window closes; see runbook.
MOYASAR_WEBHOOK_REQUIRE_VERIFIED=false
HYPERPAY_WEBHOOK_REQUIRE_VERIFIED=false

# ── Phase 1B — webhook replay protection ─────────────────────────────────────
# Two-stage rollout:
#   PROTECTION_ENABLED=true → run body-hash dedup + audit "replay" counters,
#                             but do NOT reject. Watch the dashboard.
#   REJECT_ENABLED=true     → in addition, drop replays with HTTP 200
#                             {"status":"ignored","reason":"replay"}.
# Both flags must be true for replay rejection. See runbook for sizing.
WEBHOOK_REPLAY_PROTECTION_ENABLED=false
WEBHOOK_REPLAY_REJECT_ENABLED=false

# ── Store Sync ────────────────────────────────────────────────────────────────
STORE_SYNC_MAX_PRODUCTS=500
STORE_SYNC_MAX_ORDERS=200

# ── Merchant Brain ────────────────────────────────────────────────────────────
MERCHANT_BRAIN_ENABLED=false     # true = enable for all tenants
MERCHANT_BRAIN_TENANT_IDS=       # comma-separated tenant IDs, e.g. "1,5,12"

# ── Cross-Merchant Learning ───────────────────────────────────────────────────
CROSS_MERCHANT_LEARNING_ENABLED=true
CROSS_MERCHANT_ANON_SALT=        # stable random string — MUST be set in production

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=                    # additional origins, comma-separated
CORS_ORIGIN_REGEX=https://([a-z0-9-]+\.)?nahlah\.ai

# ── API protection ────────────────────────────────────────────────────────────
API_SECRET_KEY=                  # optional internal API key for inter-service calls
